# ============================================
# SÉJOUR SÉNÉGAL — Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# ----- Base de données -----
DATABASE_URL="postgresql://sejour:sejourpassword@localhost:5432/sejoursenegal"
POSTGRES_USER=sejour
POSTGRES_PASSWORD=sejourpassword
POSTGRES_DB=sejoursenegal

# ----- JWT -----
JWT_SECRET=votre-secret-jwt-minimum-32-caracteres-CHANGEZ-EN-PRODUCTION
JWT_REFRESH_SECRET=votre-secret-refresh-minimum-32-caracteres-CHANGEZ

# ----- URLs -----
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001/api/v1

# ----- Stripe (paiement carte) -----
# Obtenez vos clés sur https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- PayTech (paiement local Sénégal) -----
# Obtenez vos clés sur https://paytech.sn
PAYTECH_API_KEY=votre-api-key-paytech
PAYTECH_API_SECRET=votre-api-secret-paytech

# ----- Email (SMTP) -----
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=votre-user-smtp
SMTP_PASS=votre-mot-de-passe-smtp
SMTP_FROM=noreply@sejoursenegal.sn

# ----- Environnement -----
NODE_ENV=development
PORT=3001
